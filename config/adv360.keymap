#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <180>;
    quick-tap-ms = <160>;
    require-prior-idle-ms = <0>;
    flavor = "balanced";
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <160>;
            require-prior-idle-ms = <0>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1              &kp N2          &kp N3              &kp N4            &kp N5  &tog 2                                                                   &mo 4        &kp N6  &kp N7             &kp N8               &kp N9           &kp N0                 &kp MINUS
&kp TAB    &kp Q               &kp W           &kp E               &kp R             &kp T   &none                                                                    &none        &kp Y   &kp U              &kp I                &kp O            &kp P                  &kp BSLH
&kp ESC    &hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F  &kp G   &none            &lt 5 DEL    &kp LALT      &tog 1         &lt 9 ESCAPE  &none        &kp H   &hm RIGHT_SHIFT J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &hm RCMD SINGLE_QUOTE  &kp SQT
&kp LSHFT  &kp Z               &kp X           &kp C               &kp V             &kp B                                 &kp HOME      &kp PG_UP                                 &kp N   &kp M              &kp COMMA            &kp DOT          &kp FSLH               &kp RSHFT
&mo 3      &kp GRAVE           &kp CAPS        &kp LEFT            &kp RIGHT                 &lt 6 BACKSPACE  &lt 7 ENTER  &kp END       &kp PAGE_DOWN  &kp TAB       &lt 8 SPACE          &kp UP             &kp DOWN             &kp LBKT         &kp RBKT               &mo 3
            >;
        };

        dota {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5  &kp NUMBER_6                                                       &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W      &kp E     &kp R      &kp T   &kp F1                                                             &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S      &kp D     &kp F      &kp G   &kp F2         &kp LCTRL  &kp LALT       &trans         &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C     &kp V      &kp B                             &kp HOME       &kp PG_UP                            &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp LA(Z)  &kp LEFT  &kp RIGHT          &kp BACKSPACE  &kp ENTER  &kp SPACE      &kp PAGE_DOWN  &kp TAB    &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 2                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        fun {
            bindings = <
&none  &none     &none         &none             &none           &none  &none                                        &none      &none            &none               &none                 &none             &none                  &none
&none  &none     &none         &none             &none           &none  &none                                        &none      &kp PRINTSCREEN  &kp F7              &kp F8                &kp F9            &kp F12                &none
&none  &kp LCMD  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none   &none  &none      &none  &kp K_MENU  &none      &kp SCROLLLOCK   &hm RIGHT_SHIFT F4  &hm RIGHT_CONTROL F5  &hm RIGHT_ALT F6  &hm RIGHT_COMMAND F11  &none
&none  &none     &none         &none             &none           &none                 &none      &none                         &kp PAUSE_BREAK  &kp F1              &kp F2                &kp F3            &kp F10                &none
&none  &none     &none         &none             &none                  &trans  &none  &none      &none  &kp TAB     &kp SPACE                   &none               &none                 &none             &none                  &none
            >;
        };

        num {
            bindings = <
&none  &none     &none         &none             &none           &none  &none                                        &none   &none             &none                     &none                 &none                   &none                        &none
&none  &none     &none         &none             &none           &none  &none                                        &none   &kp LEFT_BRACKET  &kp N7                    &kp N8                &kp N9                  &kp RIGHT_BRACKET            &none
&none  &kp LCMD  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none  &none   &none      &none  &kp PERIOD  &none   &kp EQUAL         &hm RIGHT_SHIFT NUMBER_4  &hm RIGHT_CONTROL N5  &hm RIGHT_ALT NUMBER_6  &hm RIGHT_COMMAND SEMICOLON  &none
&none  &none     &none         &none             &none           &none                 &none      &none                      &kp BACKSLASH     &kp NUMBER_1              &kp NUMBER_2          &kp NUMBER_3            &kp GRAVE                    &none
&none  &none     &none         &none             &none                  &none  &trans  &none      &none  &kp MINUS   &kp N0                    &none                     &none                 &none                   &none                        &none
            >;
        };

        sym {
            bindings = <
&none  &none     &none         &none             &none           &none  &none                                       &none     &none           &none                   &none                      &none                &none                    &none
&none  &none     &none         &none             &none           &none  &none                                       &none     &kp LEFT_BRACE  &kp AMPERSAND           &kp ASTRK                  &kp LPAR             &kp RIGHT_BRACE          &none
&none  &kp LCMD  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none  &none  &none       &none  &kp RPAR   &none     &kp PLUS        &hm RIGHT_SHIFT DOLLAR  &hm RIGHT_CONTROL PERCENT  &hm RIGHT_ALT CARET  &hm RIGHT_COMMAND COLON  &none
&none  &none     &none         &none             &none           &none                &none       &none                       &kp PIPE        &kp EXCL                &kp AT                     &kp HASH             &kp TILDE                &none
&none  &none     &none         &none             &none                  &none  &none  &trans      &none  &kp UNDER  &kp LPAR                  &none                   &none                      &none                &none                    &none
            >;
        };

        nav {
            bindings = <
&none  &none                       &none              &none                  &none                 &none         &none                                               &none  &none  &none            &none              &none          &none     &none
&none  &kp PAGE_UP                 &kp HOME           &kp UP_ARROW           &kp END               &kp INSERT    &none                                               &none  &none  &none            &none              &none          &none     &none
&none  &hm LEFT_COMMAND PAGE_DOWN  &hm LEFT_ALT LEFT  &hm LEFT_CONTROL DOWN  &hm LEFT_SHIFT RIGHT  &kp CAPSLOCK  &none          &kp DEL    &none      &none  &none   &none  &none  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RCMD  &none
&none  &kp K_UNDO                  &kp K_CUT          &kp K_COPY             &kp K_PASTE           &kp K_REDO                              &none      &none                 &none  &none            &none              &none          &none     &none
&none  &none                       &none              &none                  &none                               &kp BACKSPACE  &kp ENTER  &none      &none  &trans  &none         &none            &none              &none          &none     &none
            >;
        };

        media {
            bindings = <
&none  &none               &none                    &none                           &none                  &none  &none                                                  &none   &none  &none            &none              &none          &none     &none
&none  &kp H               &kp S                    &kp C_VOLUME_UP                 &kp V                  &kp R  &none                                                  &none   &none  &none            &none              &none          &none     &none
&none  &hm LEFT_COMMAND M  &hm LEFT_ALT K_PREVIOUS  &hm LEFT_CONTROL C_VOLUME_DOWN  &hm LEFT_SHIFT K_NEXT  &kp E  &none             &kp K_MUTE  &none      &none  &none  &none   &none  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RCMD  &none
&none  &kp N0              &kp NUMBER_1             &kp NUMBER_2                    &kp NUMBER_3           &kp O                                &none      &none                 &none  &none            &none              &none          &none     &none
&none  &none               &none                    &none                           &none                         &kp K_PLAY_PAUSE  &kp K_STOP  &none      &none  &none  &trans         &none            &none              &none          &none     &none
            >;
        };
    };
};
